POSTGRES_DB=booking
POSTGRES_USER=some-user
POSTGRES_PASSWORD=some-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable

# Сертификаты
TLS_CERT_PATH=
TLS_KEY_PATH=

# Auth (>= 32 байт)
# Генерация: openssl rand -base64 32
JWT_SECRET=
TOKEN_DURATION=15m
BCRYPT_COST=12

# Необязательно: локально адрес берется из config.yml
# Для контейнера задается в docker-compose.yml
# HTTP_ADDR=:8080

# Необязательно: локально значения берутся из config.yml
# LOG_LEVEL=info
# LOG_FORMAT=text

# Интеграционные тесты (make test-integration)
# По умолчанию берутся из POSTGRES_* выше, но имя базы всегда получает суффикс _test
# Имя базы обязано оканчиваться на _test, иначе тесты откажутся запускаться
# TEST_POSTGRES_HOST=127.0.0.1
# TEST_POSTGRES_PORT=5433
# TEST_POSTGRES_USER=
# TEST_POSTGRES_PASSWORD=
# TEST_POSTGRES_DB=
# TEST_POSTGRES_SSLMODE=disable
